DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gostoned
# Optional override for unusual networks: "require" or "disable".
DATABASE_SSL=disable
DATABASE_POOL_MAX=3
# Local smoke commands mutate only this explicitly named loopback database/role.
GOSTONE_SMOKE_DATABASE_NAME=gostoned
GOSTONE_SMOKE_DATABASE_ROLE=postgres
NEXT_PUBLIC_APP_NAME=GoStone
KATAGO_MAX_VISITS=20
KATAGO_BOT_MAX_VISITS=160
KATAGO_BOT_POLL_INTERVAL_MS=500
# External worker only: set KATAGO_DATABASE_URL and KATAGO_DATABASE_SSL=require.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Required before a public launch. Add the real values in Vercel, never here.
LEGAL_NAME=
LEGAL_ENTITY_DETAILS=
LEGAL_STREET=
LEGAL_CITY=
LEGAL_EMAIL=
LEGAL_PHONE=
LEGAL_VAT_ID=
