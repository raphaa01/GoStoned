DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gostoned
# Optional override for unusual networks: "require" or "disable".
DATABASE_SSL=disable
DATABASE_POOL_MAX=3
# Local smoke commands mutate only this explicitly named loopback database/role.
GOSTONE_SMOKE_DATABASE_NAME=gostoned
GOSTONE_SMOKE_DATABASE_ROLE=postgres
NEXT_PUBLIC_APP_NAME=GoStone
KATAGO_MAX_VISITS=32
KATAGO_BOT_MAX_VISITS=160
KATAGO_BOT_POLL_INTERVAL_MS=500
KATAGO_PUZZLE_MAX_VISITS=8
KATAGO_PUZZLE_POLL_INTERVAL_MS=2000
# Hosted scale-to-zero only. Keep proxy credentials server-side in Vercel.
KATAGO_DISPATCH_URL=
MODAL_PROXY_TOKEN_ID=
MODAL_PROXY_TOKEN_SECRET=
# External worker only: set KATAGO_DATABASE_URL and KATAGO_DATABASE_SSL=require.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Japanese is the default. Set the exact Chinese profile only for rollback.
GOSTONE_NEW_GAME_RULES_PROFILE=japanese-1989-gostone-v1
# Live scoring decisions default to five minutes (allowed range: 30-3600).
JAPANESE_SCORING_DECISION_SECONDS=300
JAPANESE_DEADLINE_RESOLVER_BATCH=20
JAPANESE_DEADLINE_RESOLVER_INTERVAL_MS=1000

# Server-only KataGo scoring provider settings. `modal-job` uses the existing
# authenticated dispatcher above; `local-job` uses the durable local worker.
KATAGO_SCORING_PROVIDER=
KATAGO_HOSTED_URL=
KATAGO_HOSTED_TOKEN=
KATAGO_LOCAL_URL=
KATAGO_ENGINE_VERSION=
KATAGO_MODEL_VERSION=
KATAGO_CONFIG_VERSION=
# Optional bounded live-contract smoke against a disposable non-production game.
KATAGO_SCORING_SMOKE_GAME_ID=
KATAGO_SCORING_SMOKE_PLAYER_KEY=
KATAGO_SCORING_SMOKE_NONPRODUCTION=

# Required before a public launch. Add the real values in Vercel, never here.
LEGAL_OPERATOR_TYPE=
LEGAL_NAME=
LEGAL_ENTITY_DETAILS=
LEGAL_PARTNER_1=
LEGAL_PARTNER_2=
LEGAL_REPRESENTED_BY=
LEGAL_STREET=
LEGAL_CITY=
LEGAL_COUNTRY=
LEGAL_EMAIL=
LEGAL_PHONE=
LEGAL_REGISTER_NAME=
LEGAL_REGISTER_NUMBER=
LEGAL_VAT_ID=
LEGAL_BUSINESS_ID=
LEGAL_SUPERVISORY_AUTHORITY=
LEGAL_EDITORIAL_NAME=
LEGAL_EDITORIAL_STREET=
LEGAL_EDITORIAL_CITY=
LEGAL_DSA_EMAIL=
