{
  "name": "gostone",
  "version": "0.1.0",
  "private": true,
  "description": "GoStone — a modern online platform for Go, Baduk and Weiqi.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . && npm run lint:i18n",
    "lint:i18n": "tsx scripts/check-i18n.ts",
    "benchmark:game-polls": "tsx scripts/benchmark-game-polls.ts",
    "mvp:check": "tsx scripts/check-mvp.ts",
    "test": "tsx --test lib/*.test.ts lib/analysis/*.test.ts lib/bot/*.test.ts lib/puzzles/*.test.ts lib/game/*.test.ts lib/rating/*.test.ts lib/auth/*.test.ts lib/client/*.test.ts lib/katago/*.test.ts lib/moderation/*.test.ts lib/i18n/*.test.ts lib/matchmaking/*.test.ts lib/stats/*.test.ts",
    "test:auth": "tsx scripts/smoke-auth-chat.ts",
    "test:clock": "tsx scripts/smoke-clock.ts",
    "test:bot-local": "tsx scripts/smoke-katago-bot.ts",
    "test:puzzles-local": "tsx scripts/smoke-katago-puzzles.ts",
    "test:live": "tsx scripts/smoke-live-game.ts",
    "test:matchmaking-races": "tsx scripts/smoke-matchmaking-races.ts",
    "test:migration-recovery": "tsx scripts/smoke-migration-recovery.ts",
    "test:migrations-db": "tsx scripts/smoke-migrations.ts",
    "test:player-report-races": "tsx scripts/smoke-player-report-races.ts",
    "test:move-hash-db": "tsx scripts/smoke-move-hash-guard.ts",
    "test:glicko2-db": "tsx scripts/smoke-glicko2-persistence.ts",
    "test:rate-limit": "tsx scripts/smoke-rate-limit.ts",
    "test:scoring-races": "tsx scripts/smoke-scoring-races.ts",
    "test:statement-timeout": "tsx scripts/smoke-statement-timeout.ts",
    "test:browser": "playwright test",
    "typecheck": "tsc --noEmit",
    "db:prepare-ci-smoke": "tsx scripts/prepare-ci-postgres.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "worker:katago": "tsx workers/katago/index.ts",
    "worker:japanese-deadlines": "tsx scripts/run-japanese-deadline-resolver.ts"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "next": "16.2.12",
    "pg": "^8.13.1",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "@types/node": "^22.10.6",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.17.0",
    "eslint-config-next": "16.2.12",
    "dotenv": "^16.4.7",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "postcss": "8.5.18",
    "sharp": "0.35.0"
  }
}
