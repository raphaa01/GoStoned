{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": false,
    "types": ["vite/client"]
  },
  "include": [
    "mobile/**/*.ts",
    "mobile/**/*.tsx",
    "components/**/*.ts",
    "components/**/*.tsx",
    "lib/**/*.ts",
    "workers/browser/**/*.ts",
    "vite.mobile.config.ts",
    "capacitor.config.ts"
  ],
  "exclude": [
    "node_modules",
    ".next",
    "app",
    "workers/katago"
  ]
}
